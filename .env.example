# ─── Database (MariaDB via docker-compose) ───────────────────────────────
DB_HOST=localhost
# 3313 to avoid clashing with other local MariaDB instances
DB_PORT=3313
DB_NAME=wrappy
DB_USER=wrappy
DB_PASSWORD=wrappypass
DB_ROOT_PASSWORD=rootpass
# Full connection string used by Drizzle + Better Auth
DATABASE_URL=mysql://wrappy:wrappypass@localhost:3313/wrappy

# ─── Better Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-change-me-dev-secret=
# Prod: https://wrappy.gift
BETTER_AUTH_URL=http://localhost:5182

# ─── Email ───────────────────────────────────────────────────────────────
# Delivery order: RESEND_API_KEY (prod) → SMTP (dev/Mailpit) → console fallback.
#
# Dev — Mailpit (bundled in docker-compose). View captured mail at :8028.
SMTP_HOST=localhost
SMTP_PORT=1028
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Wrappy <no-reply@wrappy.gift>
MAILPIT_SMTP_PORT=1028
MAILPIT_UI_PORT=8028

# Prod — Resend (https://resend.com). Set a verified sender in EMAIL_FROM,
# e.g. "Wrappy <hello@wrappy.gift>". Takes precedence over SMTP when set.
RESEND_API_KEY=

# ─── Image storage (Cloudflare R2) ───────────────────────────────────────
# Leave blank in dev to store uploads on local disk (./.uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wrappy
UPLOAD_MAX_MB=10
# Production refuses to start without R2, because files on one instance's disk aren't visible
# to the others. Set to true only for a single-instance deploy that keeps uploads on disk.
ALLOW_LOCAL_UPLOADS=

# ─── Scaling ─────────────────────────────────────────────────────────────
# DB connections per app instance. Keep instances × this under MariaDB's max_connections.
DB_POOL_SIZE=10

# Reminder emails (list dates, stale "I'll get it" claims, Secret Santa swaps).
# On by default in production, off in dev. Links in them use BETTER_AUTH_URL.
# REMINDERS=on
# REMINDER_INTERVAL_MINUTES=60
# Price-drop checks run with the reminders (up to 40 shop pages a run). Set to off to stop them.
# PRICE_ALERTS=off
